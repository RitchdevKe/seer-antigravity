    "@aws-sdk/client-ec2": "^3.1126.0",
    "@aws-sdk/client-rds": "^3.1125.0",
    "@fontsource/epilogue": "^5.2.8",
    "@fontsource/urbanist": "^5.2.7",
    "@google/genai": "^2.10.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.14.0",
    "axios-cookiejar-support": "^6.0.5",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "idb-keyval": "^6.2.5",
    "jsonrepair": "^3.13.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "lz-string": "^1.5.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "pg-format": "^1.0.4",
    "puppeteer": "^24.43.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tough-cookie": "^6.0.1",
    "vite": "^6.2.0",
